class CyberNode:
    def __init__(self, x: float, y: float, max_w: float, max_h: float) -> None:
        self.x = x
        self.y = y
        self.base_x = x
        self.base_y = y
        self.target_x = x
        self.target_y = y
        self.norm_x = x / max_w if max_w > 0 else x
        self.norm_y = y / max_h if max_h > 0 else y
        self.speed = 0.08

    def update_normalization(self, max_w: float, max_h: float) -> None:
        if max_w > 0 and max_h > 0:
            self.base_x = self.norm_x * max_w
            self.base_y = self.norm_y * max_h

    def update_idle(self, time_val: float) -> None:
        wave1 = math.sin(time_val * 0.8 + self.base_x * 0.005) * 25
        wave2 = math.cos(time_val * 0.6 + self.base_y * 0.005) * 20
        self.target_x = self.base_x + wave1
        self.target_y = self.base_y + wave2
        self.x += (self.target_x - self.x) * self.speed
        self.y += (self.target_y - self.y) * self.speed

    def update_morph(self) -> None:
        self.x += (self.target_x - self.x) * (self.speed * 1.6)
        self.y += (self.target_y - self.y) * (self.speed * 1.6)


class CyberCanvas(QWidget):
    def __init__(self, parent: Optional[QWidget] = None) -> None:
        super().__init__(parent)
        self.nodes: List[CyberNode] = []
        self.phase = 0.0
        self.is_active = False
        self.is_morphed = False
        self.active_color = SystemConfig.THEME_ACCENT
        self.display_text = "STANDBY"
        self.display_cmd = ""
        self._init_nodes(SystemConfig.NODE_COUNT)
        
        self.render_timer = QTimer(self)
        self.render_timer.timeout.connect(self._animate_frame)
        self.render_timer.start(SystemConfig.FPS_INTERVAL)

    def _init_nodes(self, count: int) -> None:
        self.nodes.clear()
        w = max(self.width(), SystemConfig.WINDOW_WIDTH)
        h = max(self.height(), SystemConfig.WINDOW_HEIGHT)
        for _ in range(count):
            rx = random.uniform(50, w - 50)
            ry = random.uniform(50, h - 50)
            self.nodes.append(CyberNode(rx, ry, w, h))

    def resizeEvent(self, event) -> None:
        super().resizeEvent(event)
        w, h = self.width(), self.height()
        for node in self.nodes:
            node.update_normalization(w, h)

    def _animate_frame(self) -> None:
        self.phase += 0.03
        for node in self.nodes:
            if not self.is_morphed:
                node.update_idle(self.phase)
            else:
                node.update_morph()
        self.update()

    def set_active(self, state: bool) -> None:
        self.is_active = state
        if not state:
            self.is_morphed = False
            self.active_color = SystemConfig.THEME_ACCENT
            self.display_text = "STANDBY"
            self.display_cmd = ""

    def morph_to_command(self, voice_text: str, sys_cmd: str) -> None:
        self.is_morphed = True
        self.display_text = voice_text
        self.display_cmd = sys_cmd.upper()
        
        cmd_lower = sys_cmd.lower()
        if "apt" in cmd_lower or "update" in cmd_lower or "install" in cmd_lower:
            self.active_color = QColor(0, 150, 255)
        elif "nmap" in cmd_lower or "ping" in cmd_lower or "netstat" in cmd_lower:
            self.active_color = QColor(255, 140, 0)
        elif "poweroff" in cmd_lower or "shutdown" in cmd_lower or "reboot" in cmd_lower or "rm" in cmd_lower:
            self.active_color = QColor(255, 51, 85)
        elif "ls" in cmd_lower or "mkdir" in cmd_lower or "nano" in cmd_lower or "touch" in cmd_lower:
            self.active_color = QColor(0, 255, 136)
        else:
            self.active_color = QColor(190, 90, 255)

        w, h = self.width(), self.height()
        path = QPainterPath()
        path.addText(0, 0, QFont('Consolas', 48, QFont.Weight.Bold), self.display_cmd[:28])
        rect = path.boundingRect()
        
        scale_x = (w * 0.7) / rect.width() if rect.width() > 0 else 1.0
        scale_y = (h * 0.5) / rect.height() if rect.height() > 0 else 1.0
        scale = min(scale_x, scale_y, 2.0)
        
        center_x = (w - rect.width() * scale) / 2 - rect.x() * scale
        center_y = (h - rect.height() * scale) / 2 - rect.y() * scale

        sample_points = []
        for i in range(len(self.nodes)):
            t = i / len(self.nodes)
            pt = path.pointAtPercent(t)
            nx = pt.x() * scale + center_x
            ny = pt.y() * scale + center_y
            sample_points.append((nx, ny))

        random.shuffle(sample_points)
        for idx, node in enumerate(self.nodes):
            target = sample_points[idx % len(sample_points)]
            node.target_x = target[0] + random.uniform(-1.5, 1.5)
            node.target_y = target[1] + random.uniform(-1.5, 1.5)

        QTimer.singleShot(3500, self._reset_morph)

    def _reset_morph(self) -> None:
        self.is_morphed = False
        self.active_color = SystemConfig.THEME_ACCENT

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.fillRect(self.rect(), SystemConfig.THEME_BG)

        color = self.active_color if self.is_active else QColor(0, 150, 210, 100)
        
        for node in self.nodes:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(color)
            painter.drawEllipse(int(node.x) - 2, int(node.y) - 2, 4, 4)

        for i in range(0, len(self.nodes), 12):
            n1 = self.nodes[i]
            n2 = self.nodes[(i + 1) % len(self.nodes)]
            dist = math.hypot(n1.x - n2.x, n1.y - n2.y)
            if dist < 45:
                alpha = int((1 - dist / 45) * 70)
                line_color = QColor(color.red(), color.green(), color.blue(), alpha)
                painter.setPen(QPen(line_color, 0.8))
                painter.drawLine(int(n1.x), int(n1.y), int(n2.x), int(n2.y))

        painter.setPen(QColor(255, 255, 255, 70))
        painter.setFont(QFont('Consolas', 10))
        status_str = "CYBER_GRID: ACTIVE // ULTIMATE DAEMON v15" if self.is_active else "CYBER_GRID: STANDBY"
        painter.drawText(25, 35, status_str)
        
        if self.is_morphed:
            painter.setPen(self.active_color)
            painter.setFont(QFont('Consolas', 18, QFont.Weight.Bold))
            painter.drawText(QRectF(0, self.height() / 2 - 90, self.width(), 45), Qt.AlignmentFlag.AlignCenter, f">> [{self.display_cmd}] <<")
            
            painter.setPen(QColor(255, 255, 255, 220))
            painter.setFont(QFont('Arial', 12))
            painter.drawText(QRectF(0, self.height() / 2 + 35, self.width(), 35), Qt.AlignmentFlag.AlignCenter, f"({self.display_text})")


class CoreEngine(QMainWindow):
    command_signal = pyqtSignal(str)

    def __init__(self, lang: str = "ar") -> None:
        super().__init__()
        self.lang = lang
        self.active_state = False
        self.drag_pos = QPoint()
        self.sr_recognizer = sr.Recognizer()
        self.mic = sr.Microphone()
        
        self.command_signal.connect(self._process_command_safely)
        self._init_ui()

    def _init_ui(self) -> None:
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
        self.resize(SystemConfig.WINDOW_WIDTH, SystemConfig.WINDOW_HEIGHT)
        
        self.canvas = CyberCanvas(self)
        self.setCentralWidget(self.canvas)
        
        layout = QVBoxLayout(self.canvas)
        layout.setContentsMargins(18, 18, 18, 18)

        top_bar = QHBoxLayout()
        lang_tag = f"[{self.lang.upper()}]"
        self.title_label = QLabel(f"RON_CORE // LINUX TACTICAL DAEMON v15.2 {lang_tag}")
        self.title_label.setStyleSheet("color: #ff3333; font-weight: bold; font-size: 10pt; font-family: 'Consolas'; background: transparent;")
        
        min_btn = QPushButton("—")
        min_btn.setFixedSize(32, 28)
        min_btn.clicked.connect(self.showMinimized)
        
        max_btn = QPushButton("□")
        max_btn.setFixedSize(32, 28)
        max_btn.clicked.connect(self._toggle_maximize)
        
        exit_btn = QPushButton("×")
        exit_btn.setFixedSize(32, 28)
        exit_btn.clicked.connect(self.close)
        
        for btn in [min_btn, max_btn, exit_btn]:
            btn.setStyleSheet("""
                QPushButton {
                    background-color: rgba(12, 12, 18, 220);
                    color: #d0d0d8;
                    border: 1px solid rgba(35, 35, 50, 220);
                    font-family: 'Consolas';
                }
                QPushButton:hover {
                    background-color: #ff3333;
                    color: #040408;
                }
            """)
        
        top_bar.addWidget(self.title_label)
        top_bar.addStretch()
        top_bar.addWidget(min_btn)
        top_bar.addWidget(max_btn)
        top_bar.addWidget(exit_btn)
        layout.addLayout(top_bar)

        layout.addStretch()

        self.console = QTextEdit()
        self.console.setReadOnly(True)
        self.console.setFixedHeight(160)
        self.console.setStyleSheet("""
            background-color: rgba(2, 2, 6, 230);
            color: #00ff88;
            border: 1px solid rgba(20, 20, 35, 230);
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 9.5pt;
        """)
        self.console.append(f"[+] RON_CORE v15.2 online. Mode: [{self.lang.upper()}]")
        self.console.append("[+] Auto-deleting temp script execution engine active.\n")
        layout.addWidget(self.console)

        controls = QHBoxLayout()
        self.trigger_btn = QPushButton("INITIALIZE STREAM")
        self.trigger_btn.setFixedHeight(38)
        self.trigger_btn.clicked.connect(self._toggle_stream)
        
        purge_btn = QPushButton("PURGE LOGS")
        purge_btn.setFixedWidth(140)
        purge_btn.setFixedHeight(38)
        purge_btn.clicked.connect(lambda: self.console.clear())

        for btn in [self.trigger_btn, purge_btn]:
            btn.setStyleSheet("""
                QPushButton {
                    background-color: rgba(12, 12, 18, 230);
                    color: #d0d0d8;
                    border: 1px solid rgba(35, 35, 50, 230);
                    font-family: 'Consolas';
                    font-weight: bold;
                }
                QPushButton:hover {
                    background-color: #ff3333;
                    color: #040408;
                }
            """)

        controls.addWidget(self.trigger_btn)
        controls.addWidget(purge_btn)
        layout.addLayout(controls)

    def mousePressEvent(self, event) -> None:
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_pos = event.globalPosition().toPoint()

    def mouseMoveEvent(self, event) -> None:
        if event.buttons() == Qt.MouseButton.LeftButton and not self.isMaximized():
            delta = event.globalPosition().toPoint() - self.drag_pos
            self.move(self.x() + delta.x(), self.y() + delta.y())
            self.drag_pos = event.globalPosition().toPoint()

    def _toggle_maximize(self) -> None:
        if self.isMaximized():
            self.showNormal()
        else:
            self.showMaximized()

    def _toggle_stream(self) -> None:
        if not self.active_state:
            self.active_state = True
            self.canvas.set_active(True)
            self.trigger_btn.setText("TERMINATE STREAM")
            self.trigger_btn.setStyleSheet("""
                QPushButton {
                    background-color: #ff3333;
                    color: #040408;
                    border: 1px solid #ff3333;
                    font-family: 'Consolas';
                    font-weight: bold;
                }
            """)
            lang_code = "ar-AR" if self.lang == "ar" else "en-US"
            self.console.append(f"[~] Audio stream linked. Listening in [{lang_code}]...")
            threading.Thread(target=self._listen_loop, daemon=True).start()
        else:
            self.active_state = False
            self.canvas.set_active(False)
            self.trigger_btn.setText("INITIALIZE STREAM")
            self.trigger_btn.setStyleSheet("""
                QPushButton {
                    background-color: rgba(12, 12, 18, 230);
                    color: #d0d0d8;
                    border: 1px solid rgba(35, 35, 50, 230);
                    font-family: 'Consolas';
                    font-weight: bold;
                }
                QPushButton:hover { background-color: #ff3333; color: #040408; }
            """)
            self.console.append("[-] Stream closed.\n")

    def _listen_loop(self) -> None:
        try:
            with self.mic as source:
                self.sr_recognizer.adjust_for_ambient_noise(source, duration=0.5)
        except Exception:
            pass
            
        lang_code = "ar-AR" if self.lang == "ar" else "en-US"
            
        while self.active_state:
            try:
                with self.mic as source:
                    audio = self.sr_recognizer.listen(source, timeout=5, phrase_time_limit=8)
                
                text = ""
                try:
                    text = self.sr_recognizer.recognize_google(audio, language=lang_code).strip()
                except Exception:
                    pass
                
                if text:
                    self.command_signal.emit(text)
                    
            except sr.WaitTimeoutError:
                continue
            except Exception:
                pass

    # تشغيل الأمر عبر ملف مؤقت يحذف نفسه تلقائياً بعد انتهاء التيرمنال
    def _run_in_external_terminal(self, cmd_str: str, sudo_pass: str = "", su_user: str = "") -> None:
        if su_user:
            inner_cmd = f"echo '--- RON_CORE // ROOT SU SHELL [{su_user}] ---'; su - {su_user}"
        elif sudo_pass:
            inner_cmd = f"echo '{sudo_pass}' | sudo -S {cmd_str.replace('sudo ', '')}; echo; echo '======================================='; echo '[اضغط Enter أو أغلق النافذة للإنهاء]'; read"
        elif cmd_str == "bash" or cmd_str == "sh":
            inner_cmd = "echo '--- RON_CORE // USER TERMINAL ($) ---'; exec bash"
        else:
            inner_cmd = f"echo '--- RON_CORE // TACTICAL EXECUTION ---'; echo 'Command: {cmd_str}'; echo '---------------------------------------'; {cmd_str}; echo; echo '======================================='; echo '[اضغط Enter أو أغلق النافذة للإنهاء]'; read"

        def target_execution():
            temp_file = None
            try:
                # إنشاء ملف مؤقت يتم حذفه تلقائياً عند إغلاقه أو انتهاء استخدامه
                temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.sh', delete=False, encoding='utf-8')
                temp_file.write(f"#!/bin/bash\n{inner_cmd}\n")
                temp_file.close()
                os.chmod(temp_file.name, 0o755)

                launched = False
                for term, arg in TERMINALS:
                    if shutil.which(term):
                        try:
                            if term in ["qterminal", "xfce4-terminal"]:
                                proc = subprocess.Popen([term, "-e", f"bash {temp_file.name}"], start_new_session=True)
                            elif term == "gnome-terminal":
                                proc = subprocess.Popen([term, "--", "bash", temp_file.name], start_new_session=True)
                            else:
                                proc = subprocess.Popen([term, arg, temp_file.name], start_new_session=True)
                            
                            proc.wait()  # انتظار إغلاق التيرمنال من قبل المستخدم
                            launched = True
                            break
                        except Exception:
                            pass

                if not launched:
                    proc = subprocess.Popen(inner_cmd, shell=True, start_new_session=True)
                    proc.wait()

            except Exception:
                pass
            finally:
                # حذف الملف المؤقت يدوياً وفورياً لضمان عدم بقائه نهائياً
                if temp_file and os.path.exists(temp_file.name):
                    try:
                        os.remove(temp_file.name)
                    except Exception:
                        pass

        # تشغيل العملية في خلفية مستقلة لكي يبقى البرنامج الرئيسي شغالاً وبدون أي تعليق
        threading.Thread(target=target_execution, daemon=True).start()

    def _process_command_safely(self, voice_text: str) -> None:
        self.console.append(f"[>] Voice Vector: '{voice_text}'")
        
        cmd_lower = voice_text.strip().lower()

        if cmd_lower in ["خروج", "إغلاق الواجهة", "توقف", "stop", "exit"]:
            self.canvas.morph_to_command(voice_text, "exit")
            self.console.append("[!] Terminating daemon workflow...")
            QTimer.singleShot(1000, self.close)
            return
        elif cmd_lower in ["مسح الشاشة", "تطهير", "clear"]:
            self.canvas.morph_to_command(voice_text, "clear")
            self.console.clear()
            return
        elif cmd_lower in ["فتح المتصفح", "open browser"]:
            self.canvas.morph_to_command(voice_text, "browser")
            self.console.append("[+] Launching web browser interface...")
            webbrowser.open("https://www.google.com")
            return

        if any(kw in t for t in [cmd_lower] for kw in ["فتح تيرمنال", "فتح موجه", "terminal", "تيرمنال"]):
            if "جذر" in cmd_lower or "root" in cmd_lower or "su" in cmd_lower:
                dialog = ParamDialog("ROOT SU TERMINAL", [("user", "أدخل اسم المستخدم للجذر (Username, e.g. root):", False)], self)
                if dialog.exec() == QDialog.DialogCode.Accepted:
                    su_name = dialog.values.get("user", "root") or "root"
                    self.canvas.morph_to_command(voice_text, f"su - {su_name}")
                    self.console.append(f"[+] Spawning QTerminal Root SU for user [{su_name}]...")
                    self._run_in_external_terminal("", su_user=su_name)
            else:
                self.canvas.morph_to_command(voice_text, "user terminal")
                self.console.append("[+] Spawning QTerminal User Session ($)...")
                self._run_in_external_terminal("bash")
            return

        result = self._parse_and_get_command(voice_text)
        if not result:
            self.console.append("[*] Operation cancelled by user.")
            return

        sys_cmd, sudo_pass = result

        self.canvas.morph_to_command(voice_text, sys_cmd)
        self.console.append(f"[+] Executing in QTerminal: {sys_cmd}")
        
        self._run_in_external_terminal(sys_cmd, sudo_pass)
        self.console.append("    [*] QTerminal window launched successfully.\n")

    def _parse_and_get_command(self, text: str) -> Optional[Tuple[str, str]]:
        t = text.strip().lower()

        if any(kw in t for kw in ["إغلاق النظام", "اغلاق النظام", "إيقاف التشغيل", "ايقاف التشغيل", "اطفاء الجهاز", "poweroff", "shutdown"]):
            confirm = ConfirmDialog("POWER OFF SYSTEM", "هل أنت متأكد من رغبتك في إطفاء النظام؟", self)
            if confirm.exec() == QDialog.DialogCode.Accepted:
                pwd_dialog = ParamDialog("SUDO AUTHENTICATION", [("pwd", "أدخل كلمة المرور للنظام (Sudo Password):", True)], self)
                if pwd_dialog.exec() == QDialog.DialogCode.Accepted:
                    return ("poweroff", pwd_dialog.values.get("pwd", ""))
            return None

        if any(kw in t for kw in ["إعادة تشغيل", "اعادة تشغيل", "reboot"]):
            confirm = ConfirmDialog("REBOOT SYSTEM", "هل أنت متأكد من رغبتك في إعادة تشغيل الجهاز؟", self)
            if confirm.exec() == QDialog.DialogCode.Accepted:
                pwd_dialog = ParamDialog("SUDO AUTHENTICATION", [("pwd", "أدخل كلمة المرور للنظام (Sudo Password):", True)], self)
                if pwd_dialog.exec() == QDialog.DialogCode.Accepted:
                    return ("reboot", pwd_dialog.values.get("pwd", ""))
            return None

        if any(kw in t for kw in ["تثبيت حزمة", "تثبيت برنامج", "تحميل برنامج", "تثبيت"]):
            dialog = ParamDialog("PACKAGE INSTALLATION", [
                ("pkg", "أدخل اسم الحزمة أو البرنامج (Package Name):", False),
                ("pwd", "أدخل كلمة المرور للنظام (Sudo Password):", True)
            ], self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                pkg_name = dialog.values.get("pkg", "").strip()
                sudo_pwd = dialog.values.get("pwd", "").strip()
                if pkg_name:
                    return (f"apt update && apt install -y {pkg_name}", sudo_pwd)
            return None

        if "تحديث النظام" in t or "تحديث الحزم" in t or "تحديث الكتالوج" in t:
            pwd_dialog = ParamDialog("SUDO AUTHENTICATION", [("pwd", "أدخل كلمة المرور للنظام لتحديث الحزم (Sudo Password):", True)], self)
            if pwd_dialog.exec() == QDialog.DialogCode.Accepted:
                return ("apt update && apt upgrade -y", pwd_dialog.values.get("pwd", ""))
            return None

        if any(kw in t for kw in ["فحص شبكة", "فحص المنافذ", "انماب", "أنماب", "nmap"]):
            dialog = ParamDialog("NETWORK SCAN (NMAP)", [("target", "أدخل IP الهدف أو رابط الموقع (Target IP/URL):", False)], self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                target = dialog.values.get("target", "127.0.0.1")
                return (f"nmap -sS {target if target else '127.0.0.1'}", "")
            return None

        if any(kw in t for kw in ["بنج", "بنغ", "ping"]):
            dialog = ParamDialog("PING CONNECTION", [("target", "أدخل الآيب أو الموقع للاختبار (IP/Domain):", False)], self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                target = dialog.values.get("target", "8.8.8.8")
                return (f"ping -c 4 {target if target else '8.8.8.8'}", "")
            return None

        if any(kw in t for kw in ["انشاء مجلد", "إنشاء مجلد", "عمل مجلد", "مجلد جديد", "فلدر"]):
            dialog = ParamDialog("CREATE DIRECTORY", [("dirname", "أدخل اسم المجلد الجديد (Directory Name):", False)], self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                dname = dialog.values.get("dirname", "new_folder")
                return (f"mkdir -p '{dname if dname else 'new_folder'}'", "")
            return None

        if any(kw in t for kw in ["انشاء ملف", "إنشاء ملف", "عمل ملف", "ملف جديد", "فايل"]):
            dialog = ParamDialog("CREATE FILE", [("filename", "أدخل اسم الملف مع الامتداد (File Name):", False)], self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                fname = dialog.values.get("filename", "file.txt")
                return (f"touch '{fname if fname else 'file.txt'}'", "")
            return None

        if any(kw in t for kw in ["تعديل ملف", "فتح نانو", "نانو", "nano"]):
            dialog = ParamDialog("NANO EDITOR", [("filepath", "أدخل اسم أو مسار الملف للتعديل (File Path):", False)], self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                fpath = dialog.values.get("filepath", "file.txt")
                return (f"nano '{fpath if fpath else 'file.txt'}'", "")
            return None

        if "معلومات الكيرنل" in t or "إصدار النواة" in t:
            return ("uname -r", "")
        if "معلومات المعالج" in t or "بروسيسور" in t:
            return ("lscpu", "")
