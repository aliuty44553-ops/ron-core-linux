class ParamDialog(QDialog):
    def __init__(self, title_text: str, fields: List[Tuple[str, str, bool]], parent: Optional[QWidget] = None) -> None:
        super().__init__(parent)
        self.fields = fields
        self.values: Dict[str, str] = {}
        self.setWindowTitle(f"RON_CORE // {title_text}")
        self.setFixedSize(480, 240 + (len(fields) * 55))
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
        self.setStyleSheet("background-color: #04040a; color: #00ff88; border: 1px solid #ff3333;")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(25, 25, 25, 25)

        title = QLabel(f"ACTION: {title_text}")
        title.setFont(QFont("Consolas", 11, QFont.Weight.Bold))
        title.setStyleSheet("color: #ff3333; border: none;")
        layout.addWidget(title)

        self.inputs: Dict[str, QLineEdit] = {}
        for key, label, is_password in fields:
            lbl = QLabel(label)
            lbl.setFont(QFont("Arial", 10))
            lbl.setStyleSheet("color: #d0d0d8; border: none;")
            layout.addWidget(lbl)

            edit = QLineEdit()
            if is_password:
                edit.setEchoMode(QLineEdit.EchoMode.Password)
            edit.setStyleSheet("""
                QLineEdit {
                    background-color: #0c0c12;
                    color: #00ffc8;
                    border: 1px solid #232332;
                    padding: 8px;
                    font-family: 'Consolas';
                    font-size: 11pt;
                }
                QLineEdit:focus { border: 1px solid #00ffc8; }
            """)
            layout.addWidget(edit)
            self.inputs[key] = edit

        layout.addStretch()

        btn_box = QHBoxLayout()
        cancel_btn = QPushButton("CANCEL / إلغاء")
        cancel_btn.setFixedHeight(40)
        cancel_btn.setStyleSheet("""
            QPushButton {
                background-color: #1a1a24;
                color: #d0d0d8;
                font-family: 'Consolas';
                font-weight: bold;
                border: 1px solid #333345;
            }
            QPushButton:hover { background-color: #2a2a3a; }
        """)
        cancel_btn.clicked.connect(self.reject)
        
        run_btn = QPushButton("EXECUTE / تنفيذ")
        run_btn.setFixedHeight(40)
        run_btn.setStyleSheet("""
            QPushButton {
                background-color: #ff3333;
                color: #040408;
                font-family: 'Consolas';
                font-weight: bold;
                font-size: 10pt;
                border: none;
            }
            QPushButton:hover { background-color: #ff5555; }
        """)
        run_btn.clicked.connect(self._submit)

        btn_box.addWidget(cancel_btn)
        btn_box.addWidget(run_btn)
        layout.addLayout(btn_box)

        if self.inputs:
            QTimer.singleShot(50, lambda: list(self.inputs.values())[0].setFocus())

    def _submit(self) -> None:
        for k, ed in self.inputs.items():
            self.values[k] = ed.text().strip()
        self.accept()


